# Firebase (web)
VITE_FIREBASE_API_KEY=mock-api-key
VITE_FIREBASE_AUTH_DOMAIN=insummery-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=insummery-ai
VITE_FIREBASE_STORAGE_BUCKET=insummery-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# API
VITE_API_URL=http://127.0.0.1:5001/insummery-ai/us-central1/api
# VITE_DIRECT_API_URL=

# Google Analytics 4 (optional). Leave empty to disable gtag.
# Create a GA4 Web stream and paste the Measurement ID (G-XXXXXXXX).
VITE_GA_MEASUREMENT_ID=

# POST Core Web Vitals to /client-metrics for Weave monitors (default: true).
# VITE_CLIENT_METRICS_ENABLED=true
