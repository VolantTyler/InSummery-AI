  "name_resolution_cases": [
    {
      "id": "resolve_exact",
      "family": "exact",
      "profile": "tests/test_cases/profile_10_kids.json",
      "extracted": "Sam",
      "expected_resolved": "Sam",
      "expected_matched": true
    },
    {
      "id": "resolve_case_insensitive",
      "family": "exact",
      "profile": "tests/test_cases/profile_10_kids.json",
      "extracted": "sam",
      "expected_resolved": "Sam",
      "expected_matched": true
    },
    {
      "id": "resolve_full_name",
      "family": "full_name",
      "profile": "tests/test_cases/profile_10_kids.json",
      "extracted": "Sam Smith",
      "expected_resolved": "Sam",
      "expected_matched": true
    },
    {
      "id": "resolve_full_name_middle",
      "family": "full_name",
      "profile": "tests/test_cases/profile_10_kids.json",
      "extracted": "Riley Jane Smith",
      "expected_resolved": "Riley",
      "expected_matched": true
    },
    {
